# =====================================================================
# QualiAgent: Enterprise Configuration
# =====================================================================

# LLM Provider Configuration
# Supported providers: "mock" (offline demo mode), "openai", "gemini", "anthropic"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

# API Keys (Leave blank or set to 'mock' for local simulation)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Agent Execution Settings
MAX_HEALING_ITERATIONS=3
SANDBOX_TIMEOUT_SECONDS=15
ENABLE_RAG=true
RAG_TOP_K=3

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# Logging & Audit
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=true
